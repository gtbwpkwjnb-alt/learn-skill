# ── Learn Skill Configuration ────────────────────────────────────────────────
# Copy to .env and fill in your values. All fields are optional.
# As an AI skill, classification/flashcards/summary work without API keys.

# DeepSeek API (CLI standalone mode only — not needed as AI skill)
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Knowledge Base Import
# SIYUAN_TOKEN=your-token
# SIYUAN_API=http://127.0.0.1:6806
# SIYUAN_EXE=C:/Program Files/siyuan/SiYuan.exe  # override auto-detect
# OBSIDIAN_VAULT=C:/path/to/obsidian-vault
# LOGSEQ_DIR=C:/path/to/logseq-folder
# JOPLIN_TOKEN=your-token
# TRILIUM_TOKEN=your-token

# Bilibili Cookie (for full subtitle access)
# BILI_COOKIE="SESSDATA=xxx; bili_jct=xxx; DedeUserID=xxx"
# BILI_SESSDATA=xxx  # alternative: SESSDATA only

# Output
# LEARN_OUTPUT_DIR=./learn-output
# PYTHON_BIN=python  # Python interpreter path (default: python)

# Proxy (for YouTube etc.)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ── User Profile / 偏好配置 ──────────────────────────────────────
# 以下变量影响 AI 总结风格和输出格式。全部可选。
# SUMMARY_STYLE=balanced    # balanced | detailed | beginner
# OUTPUT_LANGUAGE=zh        # zh | en
# CHAPTER_LENGTH=paragraph  # paragraph | concise
# FOCUS_TAGS="深度学习,NLP" # 逗号分隔，影响知识图谱权重
