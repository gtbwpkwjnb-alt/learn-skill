# Learn Skill Configuration / 学习技能配置
# Copy this file to .env and fill in your values / 复制为 .env 并填入你的值

# DeepSeek API (required for AI classification) / DeepSeek API（AI分类必需）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# SiYuan Note (optional, for auto-import) / 思源笔记（可选，用于自动导入）
SIYUAN_TOKEN=your-siyuan-token-here
SIYUAN_API=http://127.0.0.1:6806

# Bilibili Cookie (optional, for subtitle access) / B站Cookie（可选，用于获取字幕）
BILI_COOKIE=SESSDATA=your-sessdata-here

# Obsidian Vault (optional, for export) / Obsidian库（可选，用于导出）
OBSIDIAN_VAULT=D:/MyObsidianVault
